# Copy this file to ".env" and fill in your real Neon connection string.
# Get it from: Neon dashboard -> your project -> Connection Details -> "Connection string".
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# Optional: change this to any random long string for extra security.
SESSION_SECRET=royal-torque-crm-local-secret-change-if-you-want
